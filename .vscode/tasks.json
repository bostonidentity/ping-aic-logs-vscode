{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: compile",
      "type": "npm",
      "script": "compile",
      "problemMatcher": ["$tsc"],
      "presentation": { "reveal": "silent" },
      "group": "build"
    },
    {
      "label": "npm: watch",
      "type": "npm",
      "script": "watch",
      "isBackground": true,
      "problemMatcher": {
        "owner": "esbuild",
        "pattern": [
          {
            "regexp": "^([^\\s].*)\\((\\d+,\\d+)\\): (error|warning): (.+)$",
            "file": 1,
            "location": 2,
            "severity": 3,
            "message": 4
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "\\[esbuild\\] watching",
          "endsPattern": "build finished"
        }
      },
      "presentation": { "reveal": "silent" },
      "group": "build"
    }
  ]
}
